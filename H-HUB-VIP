local function simulateHeavyLagSpike(duration)
    local startTick = tick()
    while tick() - startTick < duration do
        local heavyTask = 0
        for i = 1, 450000 do
            heavyTask = heavyTask + math.sqrt(i)
        end
        RunService.Heartbeat:Wait()
    end
end

local function teleportAndRespawnAtIsland(targetPos)
    pcall(function()
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return end

        Status.Text = "ĐANG TẠO NHIỄU MẠNG & BÙNG NỔ LAG GIẢ LẬP..."
        simulateHeavyLagSpike(0.7)
        hum.Health = 0 
        
        LocalPlayer.CharacterAdded:Wait()
        task.wait(1.2)
        
        local newChar = LocalPlayer.Character
        local newRoot = newChar:WaitForChild("HumanoidRootPart")
        local newHum = newChar:WaitForChild("Humanoid")

        Status.Text = "HỒI SINH - ÉP TỌA ĐỘ VÀ KÈM LAG CHỐNG QUÉT..."
        newRoot.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
        
        simulateHeavyLagSpike(1.0)
        task.wait(0.3)

        Status.Text = "ĐANG KHÓA CỨNG ĐỨNG YÊN LIÊN TỤC 17 GIÂY..."
        
        local lockStart = tick()
        while tick() - lockStart < 17 do
            pcall(function()
                if newRoot and newHum then
                    newRoot.Anchored = true
                    newHum.WalkSpeed = 0
                    newHum.JumpPower = 0
                end
            end)
            task.wait(0.15)
        end

        newRoot.Anchored = false
        newHum.WalkSpeed = 16
        newHum.JumpPower = 50
        Status.Text = "ĐÃ AN TOÀN - SẴN SÀNG CÀY CUỐC!"
        
        if isRunning then 
            FishingSpotCFrame = newRoot.CFrame 
        end
    end)
end

