local function flyToPos(targetPos)
    pcall(function()
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        
        if hum and root then
            -- 1. Tự sát (cho nhân vật chết)
            Status.Text = "ĐANG TỰ SÁT (CHO NHÂN VẬT CHẾT)..."
            hum.Health = 0
            
            -- Đợi nhân vật hồi sinh lại
            LocalPlayer.CharacterAdded:Wait()
            
            -- Đợi đúng 1 giây sau khi hồi sinh rồi tiến hành bay
            task.wait(1.0)
            
            char = LocalPlayer.Character
            hum = char:FindFirstChildOfClass("Humanoid")
            root = char:FindFirstChild("HumanoidRootPart")
            
            if not root or not hum then return end

            -- 2. Tiến hành ngắt mạng & bay tới đảo
            Status.Text = "ĐANG NGẮT MẠNG (ĐỢI 9 GIÂY)..."
            setLag(99999)
            task.wait(9.0)

            Status.Text = "ĐÃ HIỆN BẢNG MẤT MẠNG - ĐANG BAY TỐC ĐỘ 700..."
            root.Anchored = true 
            local targetCFrame = CFrame.new(targetPos + Vector3.new(0, 5, 0))
            
            local dist = (root.Position - targetPos).Magnitude
            local speed = 700
            local timeToTween = dist / speed
            
            local tw = TweenService:Create(root, TweenInfo.new(timeToTween, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
            tw:Play()
            
            if isRunning then FishingSpotCFrame = targetCFrame end
            
            tw.Completed:Wait()
            task.wait(1.0)
            
            root.Anchored = false
            setLag(0)
            Status.Text = "ĐÃ ĐẾN NƠI & KHÔI PHỤC MẠNG!"
        end
    end)
end

