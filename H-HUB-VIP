-- NÚT TOGGLE (ĐÓNG/MỞ TAB): HÌNH TRÒN RỖNG RUỘT, VIỀN ĐỎ + VIỀN VÀNG KIM LẤP LÁNH CỰC RÕ
local ToggleBtn = Instance.new("TextButton", ScreenGui)
ToggleBtn.Size = UDim2.new(0, 52, 0, 52)
ToggleBtn.Position = UDim2.new(0, 20, 0, 120)
ToggleBtn.BackgroundTransparency = 1 -- Rỗng ruột trong suốt
ToggleBtn.Text = ""
ToggleBtn.AutoButtonColor = false
ToggleBtn.Active = true
ToggleBtn.Draggable = true
Instance.new("UICorner", ToggleBtn).CornerRadius = UDim.new(1, 0)

-- Lớp viền đỏ bên ngoài (Độ dày 3.5)
local ToggleStrokeRed = Instance.new("UIStroke", ToggleBtn)
ToggleStrokeRed.Color = Color3.fromRGB(255, 0, 0)
ToggleStrokeRed.Thickness = 3.5

-- Lớp viền vàng kim lấp lánh bao quanh cực rõ (Độ dày 2.0 nằm sát viền trong)
local ToggleStrokeGold = Instance.new("UIStroke", ToggleBtn)
ToggleStrokeGold.Thickness = 2.0
local GoldStrokeGrad = Instance.new("UIGradient", ToggleStrokeGold)
GoldStrokeGrad.Color = ColorSequence.new({
    ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 215, 0)),
    ColorSequenceKeypoint.new(0.3, Color3.fromRGB(255, 255, 255)),
    ColorSequenceKeypoint.new(0.6, Color3.fromRGB(255, 180, 0)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 215, 0))
})
task.spawn(function()
    while true do
        GoldStrokeGrad.Rotation = (GoldStrokeGrad.Rotation + 8) % 360
        task.wait(0.04)
    end
end)

-- Chữ H đứng yên màu vàng kim lấp lánh ở giữa nút Toggle
local StaticTextH = Instance.new("TextLabel", ToggleBtn)
StaticTextH.Size = UDim2.new(1, 0, 1, 0)
StaticTextH.BackgroundTransparency = 1
StaticTextH.Text = "H"
StaticTextH.TextColor3 = Color3.fromRGB(255, 215, 0)
StaticTextH.Font = Enum.Font.GothamBold
StaticTextH.TextSize = 22
StaticTextH.TextXAlignment = Enum.TextXAlignment.Center
StaticTextH.TextYAlignment = Enum.TextYAlignment.Center

local HGrad = Instance.new("UIGradient", StaticTextH)
HGrad.Color = ColorSequence.new({
    ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 180, 0)),
    ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 180)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 180, 0))
})
task.spawn(function()
    while true do
        HGrad.Offset = Vector2.new(-1, 0)
        local tw = TweenService:Create(HGrad, TweenInfo.new(1.2, Enum.EasingStyle.Linear), {Offset = Vector2.new(1, 0)})
        tw:Play(); tw.Completed:Wait()
        task.wait(0.3)
    end
end)
