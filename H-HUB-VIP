local function flyToPos(targetPos)
    pcall(function()
        Status.Text = "ĐANG TỰ SÁT & GÂY LAG ĐÁNH LỪA SERVER..."
        
        -- Gây lag mạnh để cắt đứt liên lạc vị trí với server tạm thời
        setLag(99999)
        
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.Health =.0 -- Tự sát
            else
                char:BreakJoints()
            end
        end

        local connection
        connection = LocalPlayer.CharacterAdded:Connect(function(newChar)
            if connection then connection:Disconnect() end
            task.spawn(function()
                local newRoot = newChar:WaitForChild("HumanoidRootPart", 5)
                if newRoot then
                    Status.Text = "ĐÃ HỒI SINH - KHÓA CỨNG VỊ TRÍ 10S..."
                    
                    local targetCFrame = CFrame.new(targetPos + Vector3.new(0, 5, 0))
                    
                    -- Tăng thời gian khóa cứng lên 10 giây để triệt tiêu hoàn toàn việc bị kéo ngược
                    local lockStartTime = tick()
                    local lockConnection
                    lockConnection = RunService.RenderStepped:Connect(function()
                        if tick() - lockStartTime < 10.0 then
                            newRoot.Anchored = true
                            newRoot.CFrame = targetCFrame
                        else
                            newRoot.Anchored = false
                            if lockConnection then lockConnection:Disconnect() end
                        end
                    end)
                    
                    -- Ép vị trí liên tục ngay lập tức
                    newRoot.CFrame = targetCFrame
                    
                    task.wait(2.0)
                    
                    -- Khôi phục lại mạng bình thường sau khi server đã nhận diện vị trí mới
                    setLag(0)
                    Status.Text = "ĐÃ ĐẾN ĐẢO THÀNH CÔNG (1 PHÁT ĂN NGAY)!"
                end
            end)
        end)
    end)
end
