local function flyToPos(targetPos)
    pcall(function()
        Status.Text = "ĐANG TỰ SÁT ĐỂ ĐẾN ĐẢO..."
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.Health = 0 else char:BreakJoints() end
        end

        local connection
        connection = LocalPlayer.CharacterAdded:Connect(function(newChar)
            if connection then connection:Disconnect() end
            task.spawn(function()
                local newRoot = newChar:WaitForChild("HumanoidRootPart", 5)
                if newRoot then
                    Status.Text = "ĐÃ HỒI SINH - KHÓA CỨNG VỊ TRÍ 15S..."
                    local targetCFrame = CFrame.new(targetPos + Vector3.new(0, 5, 0))
                    local lockStartTime = tick()
                    local lockConnection
                    lockConnection = RunService.RenderStepped:Connect(function()
                        if tick() - lockStartTime < 15.0 then
                            newRoot.Anchored = true
                            newRoot.CFrame = targetCFrame
                        else
                            newRoot.Anchored = false
                            if lockConnection then lockConnection:Disconnect() end
                        end
                    end)
                    newRoot.CFrame = targetCFrame
                    if isRunning then FishingSpotCFrame = targetCFrame end
                    task.wait(3.0)
                    Status.Text = "ĐÃ ĐẾN ĐẢO THÀNH CÔNG!"
                end
            end)
        end)
    end)
end

