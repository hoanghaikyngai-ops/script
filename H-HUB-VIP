-- Cải tiến quét mũi tên thông minh hơn (bắt chuẩn mọi ký hiệu hướng dẫn mini-game)
local function solveArrows()
    local inset = GuiService:GetGuiInset()
    for _, obj in pairs(PlayerGui:GetDescendants()) do
        if obj.Visible then
            local n = string.lower(obj.Name)
            local t = (obj:IsA("TextLabel") or obj:IsA("TextButton")) and string.lower(obj.Text) or ""
            local img = (obj:IsA("ImageLabel") or obj:IsA("ImageButton")) and string.lower(obj.Image) or ""
            
            if n:find("arrow") or n:find("direction") or n:find("pointer") or n:find("mini") or
               t:find("▲") or t:find("▼") or t:find("◄") or t:find("►") or t:find("↑") or t:find("↓") or t:find("←") or t:find("→") or 
               img:find("arrow") or img:find("pointer") then
                
                local pos, sz = obj.AbsolutePosition, obj.AbsoluteSize
                if sz.X > 0 and sz.Y > 0 then
                    local cx = pos.X + sz.X / 2 + inset.X
                    local cy = pos.Y + sz.Y / 2 + inset.Y
                    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
                    task.wait(0.01)
                    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
                    return true
                end
            end
        end
    end
    return false
end

task.spawn(function()
    while task.wait(0.4) do
        if isRunning then
            pcall(function()
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if not root or not hum then return end
                
                local tool = char:FindFirstChildOfClass("Tool") or (LocalPlayer.Backpack:FindFirstChildOfClass("Tool"))
                if tool and tool.Parent ~= char then hum:EquipTool(tool) end
                
                if tool then
                    Status.Text = "Trạng thái: Đang thả câu..."
                    tool:Activate()
                    task.wait(1.5)
                    
                    -- Kích hoạt lag mạng giữ gói tin chống anti-cheat nếu bật
                    if isLagOn then settings():GetService("NetworkSettings"):SetIncomingReplicationLag(999) end
                    
                    Status.Text = "Trạng thái: Đang xử lý mini-game..."
                    local tStart = tick()
                    while tick() - tStart < 8 and isRunning do
                        solveArrows()
                        task.wait(0.01)
                    end
                    
                    if isLagOn then settings():GetService("NetworkSettings"):SetIncomingReplicationLag(0) end
                    
                    -- Click kết thúc lượt câu
                    local vp = Workspace.CurrentCamera.ViewportSize
                    VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2, 0, true, game, 1)
                    task.wait(0.05)
                    VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2, 0, false, game, 1)
                end
            end)
        end
    end
end)
