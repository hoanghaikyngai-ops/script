                    local targetPart = nil
                    
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        if obj:IsA("ProximityPrompt") then
                            local parent = obj.Parent
                            if parent and parent:IsA("BasePart") then
                                local parentName = string.lower(parent.Name)
                                if (parentName:find("merchant") or parentName:find("fish") or parentName:find("sell") or parentName:find("fishmonger")) then
                                    targetPrompt = obj
                                    targetPart = parent
                                    break
                                end
                            end
                        end
                    end

                    if targetPart then
                        root.CFrame = CFrame.new(targetPart.Position + Vector3.new(0, 0, 2), targetPart.Position)
                        task.wait(0.2)
                    end

                    -- KHÓA CHẶT TẠI NPC VÀ LẶP LIÊN TỤC ĐẾN KHI CÁ VỀ 0
                    repeat
                        Status.Text = "ĐANG BÁN CÁ (CÒN " .. tostring(fCount) .. " CON) - ĐANG KHÓA TẠI NPC..."
                        root.Anchored = true
                        hum.WalkSpeed = 0
                        hum.JumpPower = 0
                        
                        if targetPrompt then
                            pcall(function() fireproximityprompt(targetPrompt) end)
                        end
                        
                        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                        task.wait(0.1)
                        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                        task.wait(0.5)

                        clickBtn({"bán tất cả", "sell all", "bán", "sell", "confirm", "đồng ý", "all", "tất cả"})
                        task.wait(1.5)
                        fCount = getFish()
                    until fCount == 0 or not isRunning

                    Status.Text = "CÁ ĐÃ HẾT (0) - ĐANG ẤN TẠM BIỆT..."
                    local cStart = tick()
                    while tick() - cStart < 4 do 
                        clickBtn({"tạm biệt", "bye", "thoát", "close", "x", "leave", "exit"})
                        task.wait(0.3) 
                    end
                    task.wait(0.5)

                    Status.Text = "TÚI ĐÃ TRỐNG - NHẢ KHÓA VỀ BÃI CÂU..."
                    root.Anchored = false
                    hum.WalkSpeed = 16
                    hum.JumpPower = 50
                    
                    local dBack = (root.Position - FishingSpotCFrame.Position).Magnitude
                    if dBack > 3 then
                        root.Anchored = true
                        local backTween = TweenService:Create(root, TweenInfo.new(dBack / 60, Enum.EasingStyle.Linear), {CFrame = FishingSpotCFrame})
                        backTween:Play(); backTween.Completed:Wait()
                        root.Anchored = false
                    end
                end

                if not isRunning then return end

                local distToLock = (root.Position - FishingSpotCFrame.Position).Magnitude
                if distToLock > 3 then
                    root.Anchored = true
                    local backTween = TweenService:Create(root, TweenInfo.new(distToLock / 60, Enum.EasingStyle.Linear), {CFrame = FishingSpotCFrame})
                    backTween:Play(); backTween.Completed:Wait()
                    root.Anchored = false
                end
                
                root.CFrame = FishingSpotCFrame
                root.Anchored = true
                hum.WalkSpeed = 0

                local activeTool = char and char:FindFirstChildOfClass("Tool")
                local isHoldingRod = activeTool and (string.lower(activeTool.Name):find("rod") or string.lower(activeTool.Name):find("cần"))

                if not isHoldingRod then
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.One, false, game)
                    task.wait(0.05)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.One, false, game)
                    task.wait(0.5)
                    activeTool = char and char:FindFirstChildOfClass("Tool")
                    isHoldingRod = activeTool and (string.lower(activeTool.Name):find("rod") or string.lower(activeTool.Name):find("cần"))
                end

                if isHoldingRod then
                    local vp = Workspace.CurrentCamera.ViewportSize
                    
                    local spam = true
                    task.spawn(function()
                        while spam and isRunning and ScreenGui.Parent do
                            for _, k in ipairs({Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}) do
                                if not spam or not isRunning then break end
                                VirtualInputManager:SendKeyEvent(true, k, false, game)
                                task.wait(0.4) 
                                VirtualInputManager:SendKeyEvent(false, k, false, game)
                                task.wait(4.0) 
                            end
                            task.wait(4.0) 
                        end
                    end)

                    Status.Text = "ĐANG THẢ CẦN & DÙNG KỸ NĂNG..."
                    pcall(function() activeTool:Activate() end)
                    VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2 - 80, 0, true, game, 1)
                    task.wait(2)
                    VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2 - 80, 0, false, game, 1)

                    Status.Text = "ĐANG KÉO CÁ & CHỜ THÊM VÀO TÚI..."

                    local initialFish = getFish()
                    local aStart = tick()
                    
                    while tick() - aStart < 60 and isRunning and getFish() <= initialFish do 
                        solveMiniGameFast()
                        if isOneHoldOn then
                            triggerOneHit()
                        end
                        task.wait(0.01)
                    end

                    spam = false

                    VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2, 0, true, game, 1)
                    task.wait(0.05)
                    VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2, 0, false, game, 1)
                    task.wait(0.5)

                    Status.Text = "ĐÃ BẮT ĐƯỢC 1 CON - NGHỈ 5 GIÂY..."
                    task.wait(5.0)
                else
                    Status.Text = "HÃY ĐẶT CẦN CÂU VÀO Ô SỐ 1!"
                    task.wait(1)
                end
            end)
        end
    end
end)
