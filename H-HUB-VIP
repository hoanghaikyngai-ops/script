-- HÀM ĐẾM CÁ CHUẨN XÁC
local function getFish()
    local count = 0
    local function check(cont)
        if cont then
            for _, i in ipairs(cont:GetChildren()) do
                if i:IsA("Tool") then
                    local n = string.lower(i.Name)
                    if not (n:find("rod") or n:find("cần") or n:find("bait") or n:find("mồi") or n:find("potion") or n:find("thuốc") or n:find("license") or n:find("gps") or n:find("radar") or n:find("pass")) then
                        count = count + 1
                    end
                end
            end
        end
    end
    check(LocalPlayer.Backpack)
    check(LocalPlayer.Character)
    return count
end

local CUSTOM_MERCHANT_POS = Vector3.new(1264.13, 27.42, -353.30) 

-- HÀM MINI GAME TÌM MŨI TÊN & KÝ TỰ TAY CẦM SIÊU TỐC
local function solveMiniGameFast()
    local inset = GuiService:GetGuiInset()
    for _, obj in pairs(PlayerGui:GetDescendants()) do
        if obj.Visible and (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("ImageLabel") or obj:IsA("ImageButton")) then
            local n = string.lower(obj.Name)
            local t = (obj:IsA("TextLabel") or obj:IsA("TextButton")) and string.lower(obj.Text) or ""
            local img = (obj:IsA("ImageLabel") or obj:IsA("ImageButton")) and string.lower(obj.Image) or ""
            
            if n:find("arrow") or n:find("direction") or n:find("pointer") or n:find("prompt") or n:find("button") or n:find("minigame") or
               t:find("▲") or t:find("▼") or t:find("◄") or t:find("►") or t:find("↑") or t:find("↓") or t:find("←") or t:find("→") or 
               (#t == 1 and t:match("[a-z0-9]")) or 
               img:find("arrow") or img:find("pointer") or img:find("button") then
                
                local pos, sz = obj.AbsolutePosition, obj.AbsoluteSize
                if sz.X > 0 and sz.Y > 0 then
                    local cx = pos.X + sz.X / 2 + inset.X
                    local cy = pos.Y + sz.Y / 2 + inset.Y
                    
                    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
                    task.wait(0.0005)
                    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
                    return true
                end
            end
        end
    end
    return false
end

-- HÀM HỦY DIỆT: ÉP MÁU/TIẾN TRÌNH CÂU VỀ 0 LẬP TỨC (ONE-HIT)
local function triggerOneHit()
    pcall(function()
        for _, gui in pairs(PlayerGui:GetDescendants()) do
            if gui.Visible and (gui:IsA("Frame") or gui:IsA("TextLabel")) then
                local name = string.lower(gui.Name)
                if name:find("progress") or name:find("bar") or name:find("fish") or name:find("health") or name:find("container") or name:find("minigame") then
                    for _, child in pairs(gui:GetDescendants()) do
                        if child:IsA("Frame") and (child.Size.X.Scale > 0 or child.Size.X.Offset > 0) then
                            child.Size = UDim2.new(0, 0, child.Size.Y.Scale, child.Size.Y.Offset)
                        end
                    end
                end
            end
        end
    end)
end

local function clickBtn(keys)
    local inset = GuiService:GetGuiInset()
    for _, obj in pairs(PlayerGui:GetDescendants()) do
        if (obj:IsA("TextButton") or obj:IsA("TextLabel")) and obj.Visible then
            local txt = string.lower(obj.Text or "")
            for _, kw in ipairs(keys) do
                if txt:find(kw) then
                    local pos, sz = obj.AbsolutePosition, obj.AbsoluteSize
                    local cx, cy = pos.X + sz.X/2 + inset.X, pos.Y + sz.Y/2 + inset.Y
                    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
                    task.wait(0.05)
                    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
                    return true
                end
            end
        end
    end
    return false
end

