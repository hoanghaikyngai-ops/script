      task.spawn(function()
         while isRunning do
            pcall(function()
                doAutoBuySeed()
                doAutoPlant()
            end)
            task.wait(1)
         end
      end)
   end,
})

ActionTab:CreateButton({
   Name = "DỪNG SCRIPT (STOP)",
   Callback = function()
      isRunning = false
      Rayfield:Notify({Name = "Thông báo", Content = "Đã tắt hoàn toàn các tác vụ Auto Farm.", Duration = 3})
   end,
})

