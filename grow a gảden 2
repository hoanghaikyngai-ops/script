local ActionTab = Window:CreateTab("Kích Hoạt", 4483362458)
local isRunning = false

ActionTab:CreateButton({
   Name = "BẮT ĐẦU CHẠY SCRIPT (START)",
   Callback = function()
      if isRunning then 
         Rayfield:Notify({Name = "Thông báo", Content = "Hệ thống Auto Farm đang hoạt động ngầm!", Duration = 3})
         return 
      end

      isRunning = true
      Rayfield:Notify({Name = "Thành công", Content = "Đã kích hoạt vòng lặp Auto Farm!", Duration = 3})
      task.spawn(function()
         while isRunning do
            pcall(function()
                doAutoBuySeed()
                doAutoPlant()
            end)
            task.wait(1)
         end
      end)
   end,
})

ActionTab:CreateButton({
   Name = "DỪNG SCRIPT (STOP)",
   Callback = function()
      isRunning = false
      Rayfield:Notify({Name = "Thông báo", Content = "Đã tắt hoàn toàn các tác vụ Auto Farm.", Duration = 3})
   end,
})
