local function doAutoBuySeed()
    if not getgenv().Config["Buy Seed"]["Enable"] then return end
    local buyRemote = ReplicatedStorage:FindFirstChild("BuyItem") or ReplicatedStorage:FindFirstChild("BuySeed") or (ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("BuySeed"))
    if buyRemote then
        for _, seed in ipairs(getgenv().Config["Buy Seed"]["Seed"]) do
            if not getgenv().Config["Buy Seed"]["Enable"] then break end
            buyRemote:FireServer(seed, 1)
            task.wait(0.1)
        end
    end
end

local function doAutoPlant()
    if not getgenv().Config["Plant Seed"]["Enable"] then return end
    local plantRemote = ReplicatedStorage:FindFirstChild("PlantSeed") or (ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("PlantSeed"))
    local myPlot = workspace:FindFirstChild("Plots") and workspace.Plots:FindFirstChild(LocalPlayer.Name)
    if myPlot and plantRemote then
        for _, zone in ipairs(myPlot:GetChildren()) do
            if not getgenv().Config["Plant Seed"]["Enable"] then break end
            if #zone:GetChildren() == 0 then
                local currentSeed = getgenv().Config["Plant Seed"]["Seed"][1]
                if currentSeed then
                    plantRemote:FireServer(currentSeed, zone)
                    task.wait(0.2)
                end
            end
        end
    end
end

